# Copy this file to .env.local and fill in your own Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# NEXT_PUBLIC_* variables are safe to expose to the browser (that's the point
# of the anon key — Row Level Security is what actually protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it bypasses Row Level
# Security entirely and must never reach the browser. Only used by
# src/app/api/delete-account/route.ts. Find it in Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — see DEPLOYMENT.md Part 4 for the full setup walkthrough.
# Server-only, all three. Find the secret key and webhook secret under
# Developers -> API keys / Developers -> Webhooks in the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PREMIUM_PRICE_ID=price_your-premium-price-id
